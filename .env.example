# ---------------------------------------------------------------------------
# Rasa Route - environment template
#
# 1. Copy this file to `.env` in the project root:  cp .env.example .env
# 2. Fill in the real values.  `.env` is git-ignored - never commit it.
# 3. Every key here must have a matching getter in lib/app/config/env.dart.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project settings -> API.  Use the *publishable* (anon) key, never the
# service-role key: this file ships inside the app bundle.
SUPABASE_URL=https://odtmtukexckfjbuqkxyo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Z3WBHi4Q87UtlPX2-9wgxg_jspPG7uc

# --- Google Gemini (required) ----------------------------------------------
# Used by lib/external/gemini for food recognition.
GEMINI_API_KEY=Example Gemini API KEY
# GEMINI_API_KEY=EXAMPLE GEMINI API KEY2
GEMINI_MODEL=gemini-3.6-flash
# Optional: a separate key for UC500's GeminiLandmarkService. Falls back to
# GEMINI_API_KEY if left unset.
GEMINI_API_KEY_LANDMARK=EXAMPLE GEMINI API KEY3
# Optional: a separate model for UC500's GeminiLandmarkService. Falls back
# to GEMINI_MODEL if left unset.
GEMINI_MODEL_LANDMARK=gemini-3.6-flash
# Shared fallback models - used by BOTH GEMINI_MODEL (food recognition) and
# GEMINI_MODEL_LANDMARK (UC500's GeminiLandmarkService) when the primary
# model is temporarily unavailable (HTTP 429/5xx - high demand, e.g. 503).
# Comma-separated; the first that responds wins. Preferred order:
# 3.5 Flash Lite (500 RPD) -> 3.6 Flash -> 3.5 Flash -> 3.1 Flash Lite ->
# 3.7 Flash.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.7-flash
# Optional: "thinking" tokens the landmark model may spend before answering
# (0 or unset = no thinkingConfig sent, the default). Only thinking-capable
# models support it; e.g. 512 makes ambiguous-photo reads more accurate but
# makes each call slower. Remove the value if the model rejects the field.
GEMINI_THINKING_BUDGET=0
# --- OpenStreetMap (optional, defaults shown) -------------------------------
OSM_BASE_URL=https://overpass-api.de/api
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Geocoding (address suggestions + the address behind a map pin) for the
# Add-Landmark form. Nominatim's public instance - do not point this at a
# service that does not allow ~1 request/second.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Networking (optional, defaults shown) ----------------------------------
# Max time to wait for a Gemini/AI response before failing (A2 timeout = 2 min).
API_TIMEOUT_SECONDS=120

# --- Background processes (optional, defaults shown) ------------------------
LOCATION_POLL_SECONDS=30
RESTAURANT_SYNC_MINUTES=15

# --- App behaviour (optional, defaults shown) -------------------------------
# dev | staging | prod
APP_ENV=dev
ENABLE_VERBOSE_LOGGING=true
